# ========== flow-multi-account ==========
# 本文件仅用于示例/模板：不要在仓库中提交真实密钥。
#
# 参考图（reference images）默认走 OSS 上传，并在任务提交时把可公开访问的 URL
# 写入到 asset metadata.publicUrl，供下游（例如 seedance extra_body.images）使用。

# 资产传输模式：oss | s3 | local
FLOW_TASK_ASSET_TRANSPORT=oss

# OSS 基础配置（使用 oss 模式时必填，示例值请自行替换）
OSS_ENDPOINT=oss-cn-xxx.aliyuncs.com
OSS_BUCKET=xlai
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# 对外访问域名（推荐：CDN）。必须带 scheme，例如 https://cdn.example.com
# 优先级：FLOW_ASSET_CDN > S3_CDN > OSS_CDN
OSS_CDN=https://airesource.seekkai.com
# FLOW_ASSET_CDN=https://airesource.seekkai.com

# ========== S3 (AWS) ==========
# 使用 s3 模式时建议配置以下变量；如果未配置 AWS_*，代码会回退使用 OSS_ACCESS_KEY_ID/OSS_ACCESS_KEY_SECRET。
# S3_BUCKET=xlai
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# S3_CDN=https://airesource.seekkai.com
# 可选：自定义/兼容 S3 的 endpoint（例如 MinIO/R2），或强制 path-style
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_FORCE_PATH_STYLE=0

# 可选项
# OSS_SECURE=true
# FLOW_OSS_PREFIX=flow-task-system
# FLOW_OSS_TIMEOUT_MS=120000
